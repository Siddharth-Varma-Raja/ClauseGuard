DATABASE_URL=
DATABASE_URL_SYNC=
# Local dev: path to a Firebase service-account key file.
# Leave empty on a cloud host to use the host's service account instead.
FIREBASE_CREDENTIALS_JSON=
# Firebase project ID (can differ from GCP_PROJECT_ID). Used when no key file is set.
FIREBASE_PROJECT_ID=

# ── Load balancer ─────────────────────────────────────────────────────────────
# Number of trusted proxies in front of the app that append to X-Forwarded-For.
# 0 = ignore the header (local dev). 1 = behind a single load balancer.
TRUSTED_PROXY_COUNT=0

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
GEMINI_API_KEY=
# ── Firebase Web API Key (for token generator script) ─────────────────────────
# Find at: Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=
# Local development only: mounts /api/dev/* (login tokens without auth). Never set in production.
ENABLE_DEV_TOKEN=false
GCP_PROJECT_ID=
# Document AI location: must be "eu" or "us" (NOT a region like europe-west1).
GCP_LOCATION=eu
DOC_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=http://localhost:3000,https://clause-guard-ten-chi.vercel.app,https://www.clauseguard.ie,https://clauseguard.ie
