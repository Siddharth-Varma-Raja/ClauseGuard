# Copy to deploy.env (git-ignored) and fill in. setup_load_balancer.sh loads it
# automatically; a value exported in the shell still wins.
# Plain KEY=value lines only: no quotes, no comments on the same line.
# These are NOT secrets — passwords and API keys go in Secret Manager.

# Leave these three empty to reuse the values already in the project:
#   PROJECT_ID          <- Development/backend/.env  GCP_PROJECT_ID
#   DOC_AI_PROCESSOR_ID <- Development/backend/.env  DOC_AI_PROCESSOR_ID
#   FIREBASE_PROJECT_ID <- Development/frontend/.env.local  NEXT_PUBLIC_FIREBASE_PROJECT_ID
PROJECT_ID=
DOC_AI_PROCESSOR_ID=
FIREBASE_PROJECT_ID=

# Optional (defaults shown)
REGION=europe-west1
DOMAIN=api.clauseguard.ie
SQL_INSTANCE=clauseguard-db
BUCKET=clauseguard-leases-prod
DOCAI_IN_BUCKET=clauseguard-docs-in
DOCAI_OUT_BUCKET=clauseguard-docs-out
ALLOWED_ORIGINS=https://clauseguard.ie,https://www.clauseguard.ie
MIN_INSTANCES=0

# Set this to the production Firebase project. If it is empty, the script falls
# back to Development/frontend/.env.local, which may point at a development
# project and would break logins on the live site.
# FIREBASE_PROJECT_ID=clauseguard-512316   (set it in the line near the top)

# Trained clause classifier. Empty MODEL_BUCKET = keyword classifier (model off).
# Set it to the private model bucket to mount it read-only at /models.
MODEL_BUCKET=
MODEL_FILE=clause_classifier_v2.joblib
